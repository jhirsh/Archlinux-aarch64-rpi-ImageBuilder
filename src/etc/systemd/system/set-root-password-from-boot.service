[Unit]
Description=Set root's password from the boot partition
# Only when there is something to read. Dropping the file on the card later
# and rebooting works exactly the same way as doing it before the first boot.
ConditionPathExists=/boot/rootpw
# /boot is a separate FAT32 partition mounted from fstab, so the file is not
# there yet when early boot runs.
RequiresMountsFor=/boot
Before=sshd.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/set-root-password-from-boot
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
