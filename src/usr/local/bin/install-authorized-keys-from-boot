#!/bin/bash

# Install root's authorized_keys on first boot, from the boot partition.
#
# The image is published, so a key baked in at build time is a key every
# person who flashes it grants root to -- whoever happened to run the build.
# That is how upstream's images ended up authorizing their maintainers on
# other people's hardware, and doing the same thing with a different name on
# it would be no better.
#
# So the image ships with no keys, and whoever writes the card supplies their
# own. The boot partition is FAT32, so it mounts as an ordinary volume the
# moment the card is written:
#
#     cp ~/.ssh/id_ed25519.pub /Volumes/RPI64-BOOT/authorized_keys
#
# Seeds once and never clobbers: a key added later on the running machine, by
# ssh-copy-id or by hand, is not overwritten on the next boot.

set -euo pipefail

SOURCE="${AUTHORIZED_KEYS_SOURCE:-/boot/authorized_keys}"
TARGET="${AUTHORIZED_KEYS_TARGET:-/root/.ssh/authorized_keys}"

log() { echo "install-authorized-keys-from-boot: $*"; }

if [[ ! -s $SOURCE ]]; then
  log "no $SOURCE; root has no SSH keys"
  exit 0
fi

if [[ -s $TARGET ]]; then
  log "$TARGET already has keys; leaving it alone"
  exit 0
fi

# Without the CR a Windows editor will have put on every line.
install -d -m 700 "$(dirname "$TARGET")"
tr -d '\r' <"$SOURCE" >"$TARGET"
chmod 600 "$TARGET"

log "installed $(grep -c . <"$TARGET") key(s) from $SOURCE"
