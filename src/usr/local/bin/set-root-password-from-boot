#!/bin/bash

# Set root's password on first boot, from a file on the boot partition.
#
# The image is published, and anything baked into /etc/shadow is published
# with it: the hash is downloadable by anyone and can be attacked offline for
# as long as they like, on hardware of their choosing. So the image ships with
# root locked and carries no credential at all, and the password is supplied
# per card after flashing instead.
#
# The boot partition is FAT32, so it appears on macOS and Windows as an
# ordinary volume the moment the card is written. Put the password on one line
# in a file called rootpw at the top of it:
#
#     echo 'the password you want' > /Volumes/RPI64-BOOT/rootpw
#
# This reads it on the next boot, sets root's password and deletes the file.
#
# Without it root stays locked, and the SSH key built into the image is the
# only way in -- which is the intended path. This exists for the boot where
# the network does not come up and the console is all that is left.

set -euo pipefail

PASSWORD_FILE="${ROOTPW_FILE:-/boot/rootpw}"

log() { echo "set-root-password-from-boot: $*"; }

if [[ ! -f $PASSWORD_FILE ]]; then
  log "no $PASSWORD_FILE; root stays locked, log in with your SSH key"
  exit 0
fi

# One line, and without the trailing newline an editor will have added.
password=$(head -1 "$PASSWORD_FILE" | tr -d '\r\n')

if [[ -z $password ]]; then
  log "$PASSWORD_FILE is empty; root stays locked"
  rm -f "$PASSWORD_FILE"
  exit 0
fi

# Through stdin, so the password is never an argument in the process list.
printf 'root:%s\n' "$password" | chpasswd

# FAT has no secure delete, and the password sat here in the clear anyway --
# readable to anyone holding the card from the moment it was written. This is
# a removal, not a shred, and the honest mitigation is to change the password
# again later if the card was ever out of your hands.
rm -f "$PASSWORD_FILE"
sync

log "root password set from $PASSWORD_FILE, which has now been deleted"
